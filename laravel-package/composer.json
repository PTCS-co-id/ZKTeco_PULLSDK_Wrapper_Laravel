{
    "name": "ptcs/zkteco-pullsdk",
    "description": "ZKTeco PullSDK Wrapper for Laravel - A PHP implementation for ZKTeco access panel devices",
    "keywords": ["laravel", "zkteco", "pullsdk", "access-control", "fingerprint"],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "PTCS",
            "email": "dev@ptcs.co.id"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "orchestra/testbench": "^8.0|^9.0"
    },
    "autoload": {
        "psr-4": {
            "Ptcs\\ZkTeco\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ptcs\\ZkTeco\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ptcs\\ZkTeco\\Providers\\ZkTecoServiceProvider"
            ],
            "aliases": {
                "ZkTeco": "Ptcs\\ZkTeco\\Facades\\ZkTeco"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
